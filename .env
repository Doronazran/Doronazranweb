# ── Site-wide configuration ──
# The canonical site URL. This single value drives canonical tags, Open Graph,
# JSON-LD, robots.txt, sitemap.xml and search-engine submission.
# To change the domain: update this value here (or override VITE_SITE_URL in
# the Vercel project Environment Variables). No trailing slash.
VITE_SITE_URL=https://doronazran.com
