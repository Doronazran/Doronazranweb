# ⚠️ SECURITY: Environment Variables
# NEVER commit .env.local to Git!
# Copy this file to .env.local and fill in your values

# Anthropic Claude API Key (for chat widget)
# Get from: https://console.anthropic.com/account/keys
VITE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Admin Panel Password (REQUIRED for secure access)
# Set a strong, unique password - ONLY you should know this
# Minimum 12 characters recommended
VITE_ADMIN_PASSWORD=your-super-secret-admin-password-here

# Optional: IP Whitelist (comma-separated, for extra security)
# Example: 192.168.1.1,203.0.113.42
VITE_ADMIN_IP_WHITELIST=

# Optional: Session Timeout (minutes, default 60)
VITE_ADMIN_SESSION_TIMEOUT=60
